{%- set tenga = "I make work from the absence I felt as a child copying a family Bible whose images looked nothing like me. I now research Zambian histories left out of textbooks, like the Tenga Tenga, African porters of World War I. Through performance, burlap, and chitenge, I carry their memory through Mbala, asking whose history is told." -%}

{%- set afronauts -%}
<p>In 1964, Edward Mukuka Nkoloso, a member of the Zambian Freedom Fighters and the founder of the Zambia National Academy of Science, began to train the first African crew to travel to the moon. Although space travel was never realized, the Zambian Space Program has since captured the imagination of contemporary artists globally.</p>
<p>My Afronaut series stems directly from the legacy left by Nkoloso and his tenacious spirit to dream beyond his limitations. This speculative project is one of hope drawn from Zambian cultural heritage and the desire to keep reaching for the stars despite the seemingly insurmountable challenges of life.</p>
<details class="read-more">
  <summary><span class="read-more__open">Read more</span><span class="read-more__close">Read less</span></summary>
  <p>The Afronauts are also directly correlated to Christian iconographic imagery as these figures are meant to represent spiritual beings like Christian saints. Each golden helmet is a representation of a halo meant to depict their ability to transcend physical limitations and occupy a higher spiritual plane of existence. The fact that each Afronaut is a person of color speaks to their representation of divinity and the need for such diversity to reflect within Christian iconography.</p>
</details>
{%- endset -%}

{%- set coffee = "In a planned installation of sculpture, image, and sound, I turn to Mbusa, a Bemba marriage ritual from Zambia. Working in acrylic and coffee on canvas, I ask how African culture and technology shape our understanding of the world, looking back toward ancestral practices." -%}

{%- set video = "" -%}
{%- set projectGroups = [
  { key: "Afronauts", label: "Afronauts", desc: afronauts },
  { key: "Tenga Tenga", label: "Tenga Tenga", desc: tenga },
  { key: "Coffee Art", label: "Coffee Art", desc: coffee },
  { key: "Art Videos", label: "Art Videos", desc: video }
] -%}

{%- for group in projectGroups -%}
  <section class="gallery-section" id="{{ group.label | slug }}">
    <div class="gallery-section__info">
      <h2 class="gallery__heading">{{ group.label }}</h2>
      {%- if group.desc %}<div class="gallery-section__desc">{{ group.desc | safe }}</div>{% endif -%}
    </div>
    <div class="gallery{% if group.key == 'Art Videos' %} gallery--video{% endif %}">
      {%- for project in projects -%}
        {%- if project.project == group.key and project.image -%}
          {%- if group.key == "Art Videos" -%}
            {%- set meta = "" -%}
          {%- else -%}
            {%- set meta = (project.date or "") + (" · " + project.medium if project.medium else "") + (" · " + project.dimensions if project.dimensions else "") -%}
          {%- endif -%}
          <figure class="gallery__item" id="{{ project.title | slug }}">
            <button type="button" class="gallery__frame" data-lightbox-trigger
                    data-src="{{ ('/images/' + project.image) | url }}"
                    data-title="{{ project.title }}"
                    data-meta="{{ meta }}"
                    {% if project.video %}data-video="{{ project.video | url }}"{% endif %}
                    aria-label="View {{ project.title }}">
              <img src="/images/thumbs/{{ project.image }}" alt="{{ project.title }}" loading="lazy">
              {%- if project.video %}<span class="gallery__play" aria-hidden="true">&#9654;</span>{% endif -%}
            </button>
            <figcaption class="gallery__caption">
              <div class="gallery__title">{{ project.title }}</div>
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endfor -%}

<script src="/gallery-more.js"></script>

<div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">&times;</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">&larr;</button>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next image">&rarr;</button>
  <figure class="lightbox__figure">
    <img class="lightbox__image" alt="">
    <video class="lightbox__video" controls playsinline style="display:none"></video>
    <figcaption class="lightbox__caption">
      <div class="lightbox__title"></div>
      <div class="lightbox__meta"></div>
    </figcaption>
  </figure>
</div>

<script>
  (function () {
    var box = document.querySelector('[data-lightbox]');
    if (!box) return;

    var triggers = Array.prototype.slice.call(
      document.querySelectorAll('[data-lightbox-trigger]')
    );
    var img = box.querySelector('.lightbox__image');
    var vid = box.querySelector('.lightbox__video');
    var title = box.querySelector('.lightbox__title');
    var meta = box.querySelector('.lightbox__meta');
    var current = -1;

    function show(i) {
      if (i < 0 || i >= triggers.length) return;
      current = i;
      var t = triggers[i];
      var videoSrc = t.getAttribute('data-video');

      vid.pause();

      if (videoSrc) {
        img.style.display = 'none';
        vid.style.display = '';
        vid.src = videoSrc;
        img.src = '';
      } else {
        vid.style.display = 'none';
        vid.src = '';
        img.style.display = '';
        img.src = t.getAttribute('data-src');
      }

      img.alt = t.getAttribute('data-title') || '';
      title.textContent = t.getAttribute('data-title') || '';
      meta.textContent = t.getAttribute('data-meta') || '';
    }

    function open(i) {
      show(i);
      box.hidden = false;
      box.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }

    function close() {
      box.hidden = true;
      box.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      vid.pause();
      vid.src = '';
      img.src = '';
      current = -1;
    }

    function step(delta) {
      if (current < 0) return;
      var next = (current + delta + triggers.length) % triggers.length;
      show(next);
    }

    triggers.forEach(function (t, i) {
      t.addEventListener('click', function () { open(i); });
    });

    box.querySelector('[data-lightbox-close]').addEventListener('click', close);
    box.querySelector('[data-lightbox-prev]').addEventListener('click', function () { step(-1); });
    box.querySelector('[data-lightbox-next]').addEventListener('click', function () { step(1); });

    box.addEventListener('click', function (e) {
      if (e.target === box) close();
    });

    document.addEventListener('keydown', function (e) {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  })();
</script>

<script>
  (function () {
    var sections = Array.prototype.slice.call(document.querySelectorAll('.gallery-section[id]'));
    var links = document.querySelectorAll('.section-nav a');
    if (!sections.length || !links.length) return;

    function activate(id) {
      links.forEach(function (l) {
        if (l.getAttribute('href') === '#' + id) l.classList.add('is-active');
        else l.classList.remove('is-active');
      });
    }

    function onScroll() {
      var offset = window.scrollY + 80;
      var current = sections[0].id;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].offsetTop <= offset) current = sections[i].id;
      }
      activate(current);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
